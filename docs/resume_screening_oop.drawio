        <mxCell id="r4" value="extracts / PDF" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#52657a;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="fastapi" target="mgr_io">
