          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="scoring" value="&lt;b&gt;Deterministic scoring contract&lt;/b&gt;&lt;br&gt;&lt;br&gt;Match skills case-insensitively against the job; job categories take precedence.&lt;br&gt;Missing skill report = not demonstrated. Present without evidence earns no points;&lt;br&gt;it is not treated as missing, but blocks the must-have bonus and fast-track.&lt;br&gt;Must-have weight 1; preferred weight 0.5. Supported skills last used &amp;gt;=5 years&lt;br&gt;ago earn half points. Unknown dates receive no recency penalty.&lt;br&gt;Skill score = 100 x earned weighted points / available weighted points.&lt;br&gt;Computed score = 50% skills + 30% experience + 20% education.&lt;br&gt;All must-haves supported: +5. Missing must-haves: cap at 59.&lt;br&gt;Clamp final score to 0..100, round to 1 decimal; shortlist at job threshold.&lt;br&gt;Fast-track: final &amp;gt;=90, no missing/unsupported must-haves, each criterion&lt;br&gt;&amp;gt;=80, and confidence medium/high. Otherwise keep normal recommendation.&lt;br&gt;AI overall differs from computed score by &amp;gt;=25: add a human-review note.&lt;br&gt;Low confidence, stale skills, unknown dates and category mismatches add notes.&lt;br&gt;AI scores are validated; normalization rejects non-finite data and handles&lt;br&gt;legacy inputs. The AI overall score never replaces the computed score." style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;shape=note;size=16;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="430" height="535" as="geometry" />
        </mxCell>
        <mxCell id="cancel" value="&lt;b&gt;Cancellation and save behavior&lt;/b&gt;&lt;br&gt;&lt;br&gt;During screening/retry: KeyboardInterrupt or EOF cancels the entire in-memory&lt;br&gt;batch; no job/candidate/debug data from the batch has been saved.&lt;br&gt;After persistence starts: keep any records already written and report interruption.&lt;br&gt;Job-save failure stops candidate storage. Individual candidate-save failures&lt;br&gt;are reported and later candidates are still attempted.&lt;br&gt;The failed AI record is never assigned a fabricated score.&lt;br&gt;Malformed/permanent errors are not offered for manual retry." style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;shape=note;size=16;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="1190" width="430" height="285" as="geometry" />
        </mxCell>
        <mxCell id="reviewflow" value="&lt;b&gt;Saved-result and review workflow&lt;/b&gt;&lt;br&gt;&lt;br&gt;Application -&amp;gt; ScreeningStore: load jobs/results without initializing AI.&lt;br&gt;ConsoleUI: select job, display requirements, list candidates in saved CSV order.&lt;br&gt;View mode: choose candidate IDs repeatedly; blank returns to the main menu.&lt;br&gt;ReviewSession: sequential review; shortlist/reject is explicit and audited.&lt;br&gt;Skip keeps decision; jump pauses the sequence and returns to that position;&lt;br&gt;exit returns to menu; unscored/RE_ENTRY cannot receive a decision.&lt;br&gt;Recommendation and recruiter decision remain independent.&lt;br&gt;Deletion uses a separate confirmed Application -&amp;gt; ScreeningStore operation." style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;shape=note;size=16;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1110" y="1400" width="650" height="275" as="geometry" />
        </mxCell>
        <mxCell id="mapping" value="&lt;b&gt;Module ownership for the future conversion&lt;/b&gt;&lt;br&gt;&lt;br&gt;main.py -&amp;gt; Application, ScreeningService, ReviewSession, ScreeningBatch.&lt;br&gt;io_manager.py -&amp;gt; ConsoleUI, ResumeImporter, Resume, Job, ScreeningPreferences.&lt;br&gt;ai_manager.py -&amp;gt; OpenRouterClient, AIResult, SkillEvidence.&lt;br&gt;logic_manager.py -&amp;gt; ScoringEngine, ScoringRules, RankingService, Evaluation, RankingRow.&lt;br&gt;data_manager.py -&amp;gt; ScreeningStore, repositories, CsvFile, CandidateMapper,&lt;br&gt;CandidateRecord, AuditEntry, DebugResultStore.&lt;br&gt;Domain classes may live in a shared models module to avoid circular imports.&lt;br&gt;No standalone business functions remain in the proposed design; constructors,&lt;br&gt;instance methods and object collaboration replace the procedural functions." style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;shape=note;size=16;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="1800" width="1720" height="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>