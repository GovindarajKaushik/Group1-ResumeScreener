        <mxCell id="f6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#52657a;endArrow=block;endFill=1;" edge="1" parent="1" source="request" target="more">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f7" value="[yes]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#52657a;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="more" target="request">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f8" value="[no]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#52657a;endArrow=block;endFill=1;" edge="1" parent="1" source="more" target="summary">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#52657a;endArrow=block;endFill=1;" edge="1" parent="1" source="summary" target="retry">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f10" value="[yes]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#52657a;endArrow=block;endFill=1;" edge="1" parent="1" source="retry" target="prompt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#52657a;endArrow=block;endFill=1;" edge="1" parent="1" source="prompt" target="yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f12" value="[yes]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#52657a;endArrow=block;endFill=1;" edge="1" parent="1" source="yes" target="rerun">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#52657a;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="rerun" target="retry">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f14" value="[none]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#52657a;endArrow=block;endFill=1;" edge="1" parent="1" source="retry" target="score">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f15" value="[no]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#52657a;endArrow=block;endFill=1;" edge="1" parent="1" source="yes" target="score">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#52657a;endArrow=block;endFill=1;" edge="1" parent="1" source="score" target="save">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f17" value="[job saved]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#52657a;endArrow=block;endFill=1;" edge="1" parent="1" source="save" target="json">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#52657a;endArrow=block;endFill=1;" edge="1" parent="1" source="json" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="scoring" value="&lt;b&gt;Deterministic scoring contract&lt;/b&gt;&lt;br&gt;&lt;br&gt;Match skills case-insensitively against the job; job categories take precedence.&lt;br&gt;Missing skill report = not demonstrated. Present without evidence earns no points;&lt;br&gt;it is not treated as missing, but blocks the must-have bonus and fast-track.&lt;br&gt;Must-have weight 1; preferred weight 0.5. Supported skills last used &amp;gt;=5 years&lt;br&gt;ago earn half points. Unknown dates receive no recency penalty.&lt;br&gt;Skill score = 100 x earned weighted points / available weighted points.&lt;br&gt;Computed score = 50% skills + 30% experience + 20% education.&lt;br&gt;All must-haves supported: +5. Missing must-haves: cap at 59.&lt;br&gt;Clamp final score to 0..100, round to 1 decimal; shortlist at job threshold.&lt;br&gt;Fast-track: final &amp;gt;=90, no missing/unsupported must-haves, each criterion&lt;br&gt;&amp;gt;=80, and confidence medium/high. Otherwise keep normal recommendation.&lt;br&gt;AI overall differs from computed score by &amp;gt;=25: add a human-review note." style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;shape=note;size=16;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="430" height="480" as="geometry" />
        </mxCell>
        <mxCell id="cancel" value="&lt;b&gt;Cancellation and save behavior&lt;/b&gt;&lt;br&gt;&lt;br&gt;During screening/retry: KeyboardInterrupt or EOF cancels the entire in-memory&lt;br&gt;batch; no job/candidate/debug data from the batch has been saved.&lt;br&gt;After persistence starts: keep any records already written and report interruption.&lt;br&gt;The failed AI record is never assigned a fabricated score." style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;shape=note;size=16;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="1120" width="430" height="240" as="geometry" />
        </mxCell>
        <mxCell id="mapping" value="&lt;b&gt;Module ownership (Final Design)&lt;/b&gt;&lt;br&gt;&lt;br&gt;main.py -&amp;gt; Application, ReviewSession (CLI controller + review session only).&lt;br&gt;OOP/screening_service.py -&amp;gt; ScreeningService (shared coordinator for CLI &amp; APIServer).&lt;br&gt;OOP/io_manager.py -&amp;gt; ConsoleUI, ResumeImporter, TextExtractor(ABC), Resume, CandidateReport(ABC), PdfCandidateReport.&lt;br&gt;OOP/ai_manager.py -&amp;gt; AIProvider(ABC), OpenRouterClient (pure API gateway, zero business logic).&lt;br&gt;OOP/logic_manager.py -&amp;gt; ScreeningBatch, Job, ScreeningPreferences, ScoringRules, ScoringEngine, ScoringRuleStep(ABC), RankingService, Evaluation, RankingRow.&lt;br&gt;OOP/data_manager.py -&amp;gt; ScreeningStore, CsvRepository(ABC), JobRepository, CandidateRepository, AuditLog, AtomicDebugResultStore, CsvFile, CandidateMapper.&lt;br&gt;OOP/api_server.py + frontend/src/ -&amp;gt; APIServer (FastAPI REST endpoints) + ReactSPA (Advanced Deliverable GUI)." style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;shape=note;size=16;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="1800" width="1720" height="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page-5" name="5 - React GUI &amp; FastAPI Integration">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;React SPA &amp; FastAPI REST Integration (Advanced Deliverable: GUI)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Both the React Web GUI and CLI main.py share the exact same ScreeningService and four OOP managers with zero duplicated business rules.&lt;/font&gt;" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;strokeColor=none;fillColor=none;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1800" height="70" as="geometry" />
        </mxCell>

        <mxCell id="spa" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;laquo;React + Vite SPA | frontend/src/&amp;raquo;&lt;/font&gt;&lt;br&gt;&lt;b&gt;App.jsx &amp; Page Views&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;1. DashboardView (KPIs, status breakdown, top skills)&lt;br&gt;2. ScreenResumesView (Job form + threshold + PDF/DOCX upload + run batch)&lt;br&gt;3. CandidatesView (Filter/search, inspect AI evidence, shortlist/reject, PDF download)&lt;br&gt;4. JobPostingsView (View saved jobs, delete job with confirmation)&lt;br&gt;5. AuditLogView (Timestamped UTC audit trail)" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="560" height="260" as="geometry" />
        </mxCell>

        <mxCell id="fastapi" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;laquo;OOP REST Adapter | OOP/api_server.py&amp;raquo;&lt;/font&gt;&lt;br&gt;&lt;b&gt;APIServer&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;GET  /api/health (checks OPENROUTER_API_KEY)&lt;br&gt;GET  /api/jobs | DELETE /api/jobs/{job_id}&lt;br&gt;POST /api/screen (multipart resumes + job JSON + min_score)&lt;br&gt;GET  /api/candidates (search/filter query params)&lt;br&gt;PATCH /api/candidates/{id}/decision (shortlisted | rejected)&lt;br&gt;GET  /api/candidates/{id}/report.pdf (PdfCandidateReport)&lt;br&gt;GET  /api/audit (AuditEntry list)" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;fillColor=#dae8fc;strokeColor=#52657a;" vertex="1" parent="1">
          <mxGeometry x="720" y="130" width="540" height="260" as="geometry" />
        </mxCell>

        <mxCell id="cli" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;laquo;CLI Controller | main.py&amp;raquo;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Application + ReviewSession + ConsoleUI&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;1. Screen a new batch of resumes&lt;br&gt;2. View saved screening results + export PDF&lt;br&gt;3. Review saved candidates (shortlist/reject/skip/jump)&lt;br&gt;4. Delete a saved job&lt;br&gt;5. Exit" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;fillColor=#dae8fc;strokeColor=#52657a;" vertex="1" parent="1">
          <mxGeometry x="1360" y="130" width="460" height="260" as="geometry" />
        </mxCell>

        <mxCell id="coord" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;laquo;Shared Pipeline | OOP/screening_service.py&amp;raquo;&lt;/font&gt;&lt;br&gt;&lt;b&gt;ScreeningService&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;+ create_batch() + screen_batch() + retry_failed()&lt;br&gt;+ evaluate_and_rank() + persist_batch()" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;fillColor=#dae8fc;strokeColor=#52657a;" vertex="1" parent="1">
          <mxGeometry x="720" y="490" width="540" height="140" as="geometry" />
        </mxCell>

        <mxCell id="mgr_io" value="&lt;b&gt;IO Manager&lt;/b&gt;&lt;br&gt;ResumeImporter + TextExtractor&lt;br&gt;+ PdfCandidateReport" style="html=1;whiteSpace=wrap;rounded=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="mgr_ai" value="&lt;b&gt;AI Manager (Gateway Only)&lt;/b&gt;&lt;br&gt;AIProvider -&gt; OpenRouterClient&lt;br&gt;(Prompt + JSON Validation)" style="html=1;whiteSpace=wrap;rounded=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="480" y="740" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="mgr_logic" value="&lt;b&gt;Logic Manager&lt;/b&gt;&lt;br&gt;ScoringEngine + RankingService&lt;br&gt;+ ScreeningBatch + Rules" style="html=1;whiteSpace=wrap;rounded=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="920" y="740" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="mgr_data" value="&lt;b&gt;Data Manager&lt;/b&gt;&lt;br&gt;ScreeningStore + CsvRepositories&lt;br&gt;+ AtomicDebugResultStore" style="html=1;whiteSpace=wrap;rounded=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1360" y="740" width="460" height="120" as="geometry" />
        </mxCell>

        <mxCell id="docker_note" value="&lt;b&gt;Docker &amp; Runtime Deployment&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Production Docker image (Dockerfile): multi-stage build compiles React SPA into frontend/dist and serves both API + SPA via uvicorn OOP.api_server:app on port 8000.&lt;br&gt;- Development (docker-compose.yml): Vite dev server (:5173) proxies /api/* to FastAPI (:8000).&lt;br&gt;- CLI Mode: python main.py runs Application directly in terminal using the exact same managers and data/ persistence." style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;shape=note;size=16;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="940" width="1780" height="150" as="geometry" />
        </mxCell>

