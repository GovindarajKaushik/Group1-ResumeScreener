        <mxCell id="store_ref" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;laquo;persistence facade | OOP/data_manager.py&amp;raquo;&lt;/font&gt;&lt;br&gt;&lt;b&gt;ScreeningStore&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- _jobs: JobRepository&lt;br&gt;- _candidates: CandidateRepository&lt;br&gt;- _audit: AuditLog&lt;br&gt;- _debug: AtomicDebugResultStore&lt;hr&gt;+ save_job() / load_jobs() / delete_job()&lt;br&gt;+ save_all() / load_results() / update_decision()&lt;br&gt;+ search_candidates() / load_audit() / save_debug()" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;fillColor=#dae8fc;strokeColor=#52657a;" vertex="1" parent="1">
          <mxGeometry x="1720" y="450" width="480" height="230" as="geometry" />
        </mxCell>

        <mxCell id="scope" value="&lt;b&gt;Architecture &amp; Manager Boundaries&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. main.py contains ONLY Application &amp; ReviewSession (CLI flow).&lt;br&gt;2. OOP/screening_service.py contains ScreeningService (shared coordinator for CLI &amp; APIServer).&lt;br&gt;3. OOP/ai_manager.py contains ONLY AIProvider + OpenRouterClient (no scoring or batch logic).&lt;br&gt;4. OOP/logic_manager.py holds ScreeningBatch, ScoringEngine, RankingService, and all business rules.&lt;br&gt;5. OOP/io_manager.py holds ConsoleUI, ResumeImporter, TextExtractor, and PdfCandidateReport.&lt;br&gt;6. OOP/data_manager.py holds ScreeningStore and CSV/JSON repositories." style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;shape=note;size=16;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1720" y="1210" width="480" height="250" as="geometry" />
        </mxCell>

