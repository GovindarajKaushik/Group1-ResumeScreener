        <mxCell id="p12" value="1 audit log / 0..* entries" edge="1" parent="1" source="audit" target="auditentry" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page-4" name="4 - Screening activity and scoring rules">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="2070" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Screening workflow - UML activity&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Responsibility labels show which object performs each action. Guard labels show the preserved branches.&lt;/font&gt;" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;strokeColor=none;fillColor=none;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1800" height="70" as="geometry" />
        </mxCell>
        <mxCell id="start" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="770" y="110" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="input" value="CLI (Application + ConsoleUI) OR Web (ReactSPA + APIServer) + ResumeImporter&lt;br&gt;Collect readable anonymized resumes, job and threshold" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;rounded=1;arcSize=18;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="510" y="175" width="560" height="75" as="geometry" />
        </mxCell>
        <mxCell id="valid" value="Resumes ready?" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;shape=rhombus;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="710" y="290" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="exit" value="ConsoleUI / API Error: return&lt;br&gt;Missing API key / no readable resumes / cancelled batch" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;rounded=1;arcSize=18;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="430" height="95" as="geometry" />
        </mxCell>
        <mxCell id="client" value="OpenRouterClient (AIProvider)&lt;br&gt;Initialize from environment; reuse client for this batch" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;rounded=1;arcSize=18;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="550" y="425" width="480" height="75" as="geometry" />
        </mxCell>
        <mxCell id="request" value="ScreeningService + OpenRouterClient&lt;br&gt;Screen next resume; validate JSON; capture status/error/time" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;rounded=1;arcSize=18;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="550" y="555" width="480" height="75" as="geometry" />
        </mxCell>
        <mxCell id="more" value="More resumes?" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;shape=rhombus;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="710" y="680" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="summary" value="ConsoleUI / API Response + ScreeningBatch&lt;br&gt;Report successes and failures" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;rounded=1;arcSize=18;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="550" y="815" width="480" height="75" as="geometry" />
        </mxCell>
        <mxCell id="retry" value="Retryable failures?" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;shape=rhombus;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="710" y="940" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="prompt" value="ConsoleUI / User&lt;br&gt;Ask whether to retry temporary failures" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;rounded=1;arcSize=18;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1110" y="945" width="450" height="75" as="geometry" />
        </mxCell>
        <mxCell id="yes" value="Retry chosen?" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;shape=rhombus;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="1255" y="1080" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="rerun" value="ScreeningService&lt;br&gt;Retry only retryable failed records; replace records; update summary" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;rounded=1;arcSize=18;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1110" y="1220" width="450" height="85" as="geometry" />
        </mxCell>
        <mxCell id="score" value="ScoringEngine + RankingService&lt;br&gt;Evaluate usable AI results; rank fast-track first, then score,&lt;br&gt;then descending resume ID for ties" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;rounded=1;arcSize=18;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="550" y="1220" width="480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="save" value="ScreeningStore&lt;br&gt;Save job + audit first; then each candidate + audit;&lt;br&gt;failed/invalid records are saved unscored as RE_ENTRY" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;rounded=1;arcSize=18;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="550" y="1400" width="480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="json" value="AtomicDebugResultStore&lt;br&gt;Write optional JSON once; warn on failure; return results" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;rounded=1;arcSize=18;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="550" y="1580" width="480" height="85" as="geometry" />
        </mxCell>
        <mxCell id="end" value="" style="shape=doubleEllipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="770" y="1720" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#52657a;endArrow=block;endFill=1;" edge="1" parent="1" source="start" target="input">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#52657a;endArrow=block;endFill=1;" edge="1" parent="1" source="input" target="valid">
          <mxGeometry relative="1" as="geometry" />
