  <diagram id="page-3" name="3 - Persistence and saved records">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1940" pageHeight="1850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Persistence Objects &amp; Saved Candidate Records (OOP/data_manager.py)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;CsvRepository(ABC) hierarchy, ScreeningStore facade, AtomicFileWriter, and CSV/JSON persistence.&lt;/font&gt;" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;strokeColor=none;fillColor=none;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1840" height="70" as="geometry" />
        </mxCell>

        <mxCell id="store" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;laquo;persistence facade | OOP/data_manager.py&amp;raquo;&lt;/font&gt;&lt;br&gt;&lt;b&gt;ScreeningStore&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- _jobs: JobRepository&lt;br&gt;- _candidates: CandidateRepository&lt;br&gt;- _audit: AuditLog&lt;br&gt;- _debug: AtomicDebugResultStore&lt;hr&gt;+ save_job(job, preferences): str&lt;br&gt;+ save_record(record, resume, evaluation, job): str&lt;br&gt;+ save_all(records, resumes, evaluations, job): list[str]&lt;br&gt;+ load_jobs(): list[SavedJob]&lt;br&gt;+ load_results(job_id?): list[CandidateRecord]&lt;br&gt;+ update_decision(candidate_id, decision): bool&lt;br&gt;+ save_feedback(candidate_id, rating): bool&lt;br&gt;+ delete_job(job_id): int?&lt;br&gt;+ search_candidates(**filters): list[CandidateRecord]&lt;br&gt;+ load_audit(): list[AuditEntry]&lt;br&gt;+ save_debug(records): None" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;fillColor=#dae8fc;strokeColor=#52657a;" vertex="1" parent="1">
          <mxGeometry x="680" y="120" width="500" height="350" as="geometry" />
        </mxCell>

        <mxCell id="csvrepo_abc" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;laquo;abstract repository | OOP/data_manager.py&amp;raquo;&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;b&gt;CsvRepository&lt;/b&gt;&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;- _csv: CsvFile&lt;br&gt;- _path: str&lt;hr&gt;+ load_all(): list {abstract}" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="680" y="510" width="500" height="120" as="geometry" />
        </mxCell>

        <mxCell id="jobs" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;laquo;repository&amp;raquo;&lt;/font&gt;&lt;br&gt;&lt;b&gt;JobRepository&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- path = data/jobs.csv&lt;hr&gt;+ save(job, preferences): str&lt;br&gt;+ load_all(): list[SavedJob]&lt;br&gt;+ find(job_id): SavedJob?&lt;br&gt;+ delete(job_id): bool" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;fillColor=#dae8fc;strokeColor=#52657a;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="480" height="190" as="geometry" />
        </mxCell>

        <mxCell id="candidates" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;laquo;repository&amp;raquo;&lt;/font&gt;&lt;br&gt;&lt;b&gt;CandidateRepository&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- mapper: CandidateMapper&lt;br&gt;- audit: AuditLog&lt;br&gt;- path = data/candidate_results.csv&lt;hr&gt;+ save(candidate): str&lt;br&gt;+ load_all() / load_job_results(job_id)&lt;br&gt;+ update_field() / delete_for_job()&lt;br&gt;+ search(**filters) / count_by_status()" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;fillColor=#dae8fc;strokeColor=#52657a;" vertex="1" parent="1">
          <mxGeometry x="680" y="690" width="500" height="230" as="geometry" />
        </mxCell>

        <mxCell id="audit" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;laquo;repository&amp;raquo;&lt;/font&gt;&lt;br&gt;&lt;b&gt;AuditLog&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- path = data/audit_log.csv&lt;hr&gt;+ append(action, details, candidate_ids): None&lt;br&gt;+ load_all(): list[AuditEntry]&lt;br&gt;+ historical_candidate_ids(): list[str]" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;fillColor=#dae8fc;strokeColor=#52657a;" vertex="1" parent="1">
          <mxGeometry x="1350" y="690" width="500" height="165" as="geometry" />
        </mxCell>

        <mxCell id="debug" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;laquo;subclass of DebugResultStore&amp;raquo;&lt;/font&gt;&lt;br&gt;&lt;b&gt;AtomicDebugResultStore&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- path = data/resume_results.json&lt;br&gt;- writer: AtomicFileWriter&lt;hr&gt;+ save(records): None" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;fillColor=#dae8fc;strokeColor=#52657a;" vertex="1" parent="1">
          <mxGeometry x="1350" y="920" width="500" height="145" as="geometry" />
        </mxCell>

        <mxCell id="csv" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;laquo;file adapter&amp;raquo;&lt;/font&gt;&lt;br&gt;&lt;b&gt;CsvFile + AtomicFileWriter&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;+ read(path, fields): list[row]&lt;br&gt;+ write_atomic(path, fields, rows): None&lt;br&gt;+ append(path, fields, row): None" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;fillColor=#dae8fc;strokeColor=#52657a;" vertex="1" parent="1">
          <mxGeometry x="40" y="1020" width="480" height="160" as="geometry" />
        </mxCell>

        <mxCell id="mapper" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;laquo;serialization&amp;raquo;&lt;/font&gt;&lt;br&gt;&lt;b&gt;CandidateMapper + FieldCodec&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;+ from_screening(record, resume, evaluation, job): CandidateRecord&lt;br&gt;+ to_row(candidate): row&lt;br&gt;+ from_row(row): CandidateRecord" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;fillColor=#dae8fc;strokeColor=#52657a;" vertex="1" parent="1">
          <mxGeometry x="680" y="1020" width="500" height="150" as="geometry" />
        </mxCell>

        <mxCell id="candidate" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;laquo;saved projection | one job-specific screening&amp;raquo;&lt;/font&gt;&lt;br&gt;&lt;b&gt;CandidateRecord&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;+ candidate_id, job_id?, job_title, file_name&lt;br&gt;+ final_score?, skills_score?, experience_score?, education_score?&lt;br&gt;+ status, fast_track, confidence, evidence, summary, notes&lt;br&gt;+ recruiter_decision: pending | shortlisted | rejected&lt;hr&gt;+ can_record_decision(): bool&lt;br&gt;+ set_decision(decision): None&lt;br&gt;+ set_feedback(rating): None" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;fillColor=#dae8fc;strokeColor=#52657a;" vertex="1" parent="1">
          <mxGeometry x="1350" y="1140" width="500" height="240" as="geometry" />
        </mxCell>

        <mxCell id="auditentry" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;AuditEntry&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;+ timestamp: str (UTC +00:00)&lt;br&gt;+ action: str&lt;br&gt;+ candidate_id: str&lt;br&gt;+ details: str" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;">
          <mxGeometry x="1350" y="120" width="500" height="160" as="geometry" />
        </mxCell>

        <mxCell id="compat" value="&lt;b&gt;Storage and compatibility rules&lt;/b&gt;&lt;br&gt;&lt;br&gt;Job IDs: next Jnnn from currently saved jobs.&lt;br&gt;Candidate IDs: next Cnnn from current rows AND audit history; never reuse deleted IDs.&lt;br&gt;Save failed API calls or invalid evaluations as RE_ENTRY with null score and error notes.&lt;br&gt;StorageError(ValueError) handles corrupt or unreadable CSVs gracefully." style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;shape=note;size=16;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="560" height="220" as="geometry" />
        </mxCell>

        <mxCell id="safety" value="&lt;b&gt;Write, delete and error behavior&lt;/b&gt;&lt;br&gt;&lt;br&gt;CSV/JSON writes use AtomicFileWriter (temp file + atomic replace).&lt;br&gt;Deletion requires confirmation, removes only the selected job and linked rows, keeps audit history,&lt;br&gt;and restores candidates if the job-file write fails.&lt;br&gt;Debug JSON failure is a warning and does not block CSV results." style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;shape=note;size=16;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="1450" width="1810" height="170" as="geometry" />
        </mxCell>

        <mxCell id="p1" value="owns" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#52657a;startArrow=diamond;startFill=1;endArrow=none;" edge="1" parent="1" source="store" target="jobs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="owns" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#52657a;startArrow=diamond;startFill=1;endArrow=none;" edge="1" parent="1" source="store" target="candidates">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="owns" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#52657a;startArrow=diamond;startFill=1;endArrow=none;" edge="1" parent="1" source="store" target="audit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="owns" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#52657a;startArrow=diamond;startFill=1;endArrow=none;" edge="1" parent="1" source="store" target="debug">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="extends" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#82b366;endArrow=block;endFill=0;" edge="1" parent="1" source="jobs" target="csvrepo_abc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6" value="extends" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#82b366;endArrow=block;endFill=0;" edge="1" parent="1" source="candidates" target="csvrepo_abc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7" value="extends" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#82b366;endArrow=block;endFill=0;" edge="1" parent="1" source="audit" target="csvrepo_abc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p8" value="aggregates shared CsvFile" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#52657a;startArrow=diamond;startFill=0;endArrow=none;" edge="1" parent="1" source="csvrepo_abc" target="csv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p9" value="serializes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#52657a;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="candidates" target="mapper">
          <mxGeometry relative="1" as="geometry" />
