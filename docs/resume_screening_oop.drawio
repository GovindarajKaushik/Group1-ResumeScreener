        <mxCell id="title" value="&lt;b&gt;Resume Screening — Overall OOP Application Design&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Four-manager architecture shared by CLI (main.py) and Web GUI (APIServer + React SPA). All domain logic lives in the managers; AIManager/OpenRouterClient is a pure API gateway.&lt;/font&gt;" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;strokeColor=none;fillColor=none;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;Reading this UML&lt;/b&gt;&lt;br&gt;&lt;br&gt;+ public; - private; ? optional (0..1).&lt;br&gt;Green box = ABC / Interface.&lt;br&gt;Blue box = Concrete class / service.&lt;br&gt;Hollow triangle = Generalization / Realization.&lt;br&gt;Filled diamond = Composition; Hollow diamond = Aggregation.&lt;br&gt;Solid line = Association; Dashed open arrow = Dependency." style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;spacing=10;strokeWidth=1.5;shape=note;size=16;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="460" height="220" as="geometry" />
        </mxCell>

