        <mxCell id="f3" value="[no]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#52657a;endArrow=block;endFill=1;" edge="1" parent="1" source="valid" target="exit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="[yes]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#52657a;endArrow=block;endFill=1;" edge="1" parent="1" source="valid" target="client">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#52657a;endArrow=block;endFill=1;" edge="1" parent="1" source="client" target="request">
          <mxGeometry relative="1" as="geometry" />
